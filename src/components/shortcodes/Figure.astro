---
import type { ImageMetadata } from "astro";
import { fit } from "~/lib/images.ts";

/** The former `figure` shortcode: an image of the page bundle, fitted in 1200×1200, with a caption. */
interface Props {
    src: ImageMetadata;
    alt?: string;
    caption?: string;
    title?: string;
    attr?: string;
    attrlink?: string;
    link?: string;
    target?: string;
    rel?: string;
    class?: string;
    width?: string | number;
    height?: string | number;
}

const { src, alt, caption, title, attr, attrlink, link, target, rel, class: className, width, height } = Astro.props;
const figure = await fit(src, 1200, { quality: 90 });
---

<figure class={className}>
    {
        link ? (
            <a href={link} target={target} rel={rel}>
                <img src={figure} alt={alt || caption} width={width} height={height} />
            </a>
        ) : (
            <img src={figure} alt={alt || caption} width={width} height={height} />
        )
    }
    {
        (title || caption || attr) && (
            <figcaption>
                {title && <h4>{title}</h4>}
                {(caption || attr) && (
                    <p>
                        {caption}
                        {attrlink ? <a href={attrlink}>{attr}</a> : attr}
                    </p>
                )}
            </figcaption>
        )
    }
</figure>
